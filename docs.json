{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "linden",
  "name": "Fluton",
  "colors": {
    "primary": "#2B63D9",
    "light": "#2B63D9",
    "dark": "#2B63D9"
  },
  "favicon": "/favicon-dark.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "👋 Welcome",
            "pages": [
              "pages/welcome/introduction",
              "pages/welcome/confidential-architecture",
              "pages/welcome/shielding",
              "pages/welcome/payment",
              "pages/welcome/flutonized-vaults",
              "pages/welcome/testnet-guide"
            ]
          },
          {
            "group": "Concepts",
            "pages": ["pages/concepts/cERC20", "pages/concepts/encrypted-intents"]
          },
          {
            "group": "Developer Documentation",
            "pages": [
              {
                "group": "Fluton SDK",
                "expanded": false,
                "pages": ["pages/developer-documentation/fluton-sdk/overview"]
              },
              "pages/developer-documentation/smart-contracts"
            ]
          },
          {
            "group": "Resources",
            "pages": ["pages/resources/FAQ", "pages/resources/brandkit", "pages/resources/brand-guidelines"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://docs.fluton.io",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://fluton.io/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/logo/light.svg",
    "dark": "/images/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "icon": "discord",
        "label": "Discord",
        "href": "https://discord.gg/fluton"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/FlutonIO",
      "github": "https://github.com/Fluton-io",
      "discord": "https://discord.gg/fluton"
    }
  }
}
